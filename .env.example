# Copy to .env and fill in. Only the TMDB key is required; everything else
# just unlocks more features. Never commit the real .env.

# The catalog. Free from https://www.themoviedb.org/settings/api
WD_TMDB_API_KEY=

# IMDb, Rotten Tomatoes and Metacritic scores (free tier is fine)
WD_OMDB_API_KEY=

# Which port to serve on. http://localhost:8080 by default.
WD_PORT=8080

# Where the app is reachable, used for links in alerts and for the OIDC
# callback. Change this if you reach it at anything other than localhost.
WD_PUBLIC_BASE_URL=http://localhost:8080

# Signs sessions and encrypts the AI key. Left empty, the API generates one
# on first boot and keeps it in its data volume, which is what most people
# want. Set your own (openssl rand -hex 32) if you run more than one API
# container or want it under your own management.
WD_SECRET_KEY=

# Set to true once the app is behind HTTPS. Left false, sign-in works over
# plain HTTP on a LAN or tailnet address, where a secure cookie is dropped.
WD_COOKIE_SECURE=false

# The bundled Postgres password. It is only reachable from inside the
# compose network, so the default is fine unless you expose the database.
WD_DB_PASSWORD=watchdeck

# Availability fallback before anyone sets their country, e.g. US, FR, MA.
WD_DEFAULT_COUNTRY=

# Optional single sign-on (OIDC, tested with Pocket ID). Leave empty for
# username and password sign-in.
WD_OIDC_ISSUER=
WD_OIDC_CLIENT_ID=
WD_OIDC_CLIENT_SECRET=

# Optional email alerts through Resend
WD_RESEND_API_KEY=
WD_RESEND_FROM=

# Optional push through ntfy. Empty means off.
WD_NTFY_URL=
